#!/bin/bash

# Run the example tests. The list of tests is in run_tests.py.
#
#   ./go -c          check the disassemblies against known good
#   ./go -m          make known good
#   ./go -x          make extra files (reports, symbol files etc)
#
# See './run_tests.py --help' for more options (e.g. running particular tests).

cd "$(dirname "$0")" && exec python3 run_tests.py "$@"
